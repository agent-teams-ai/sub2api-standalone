{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "newLine": "lf",
    "outDir": "generated/runtime",
    "types": ["node"]
  },
  "include": ["index.ts", "reject-legacy-typescript.ts", "generated/rules.d.cts"]
}
