{
  "name": "sub2api-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "check:i18n": "vitest run src/i18n/__tests__/localeKeyCompleteness.spec.ts",
    "build": "pnpm run check:i18n && pnpm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "pnpm run lint:qualify && node tools/eslint-syntax/run-eslint.ts --fix",
    "lint:check": "pnpm run lint:qualify && node tools/eslint-syntax/run-eslint.ts",
    "typecheck": "tsc -b --runExternalCode && pnpm run typecheck:providers",
    "typecheck:providers": "tsc --runExternalCode --project tsconfig.providers-tests.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:qualify": "node --import ./tools/eslint-syntax/reject-legacy-typescript.ts ./node_modules/typescript/lib/tsc.js --project tools/eslint-syntax/tsconfig.json && node --import ./tools/eslint-syntax/reject-legacy-typescript.ts tools/eslint-syntax/build.ts --check && node --import ./tools/eslint-syntax/reject-legacy-typescript.ts --test tools/eslint-syntax/guard.test.ts tools/eslint-syntax/qualify.test.ts"
  },
  "dependencies": {
    "@airwallex/components-sdk": "^1.30.2",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.20.0",
    "chart.js": "^4.4.1",
    "dompurify": "^3.4.17",
    "driver.js": "^1.4.0",
    "file-saver": "^2.0.5",
    "marked": "^17.0.1",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.2.5",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@agent-teams/eslint-native-syntax": "file:tools/eslint-syntax",
    "@eslint-community/eslint-utils": "4.10.1",
    "@intlify/message-compiler": "11.4.16",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "1.15.9",
    "@typescript-eslint/scope-manager": "8.73.0",
    "@typescript-eslint/types": "8.73.0",
    "@typescript-eslint/visitor-keys": "8.73.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/content-mapper": "4.0.0-alpha.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-parser-oxc": "0.1.1",
    "eslint-plugin-vue": "10.12.1",
    "globals": "13.24.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "7.1.0-beta",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "10.4.2"
  },
  "pnpm": {
    "overrides": {
      "js-cookie": "3.0.7",
      "form-data@<4.0.6": ">=4.0.6",
      "postcss@<8.5.18": ">=8.5.18",
      "dompurify@<3.4.17": ">=3.4.17",
      "decode-uri-component@<0.5.1": ">=0.5.1",
      "source-map-js@<1.2.2": "1.2.2",
      "follow-redirects@<1.16.2": ">=1.16.2",
      "js-beautify@1.15.4>glob": "14.0.0",
      "editorconfig@1.0.4>minimatch": "11.0.9"
    }
  }
}
