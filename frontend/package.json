{
  "name": "sub2api-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "check:i18n": "vitest run src/i18n/__tests__/localeKeyCompleteness.spec.ts",
    "build": "pnpm run check:i18n && pnpm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck": "tsc -b --runExternalCode && pnpm run typecheck:providers",
    "typecheck:providers": "tsc --runExternalCode --project tsconfig.providers-tests.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@airwallex/components-sdk": "^1.30.2",
    "@lobehub/icons": "^4.0.2",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.20.0",
    "chart.js": "^4.4.1",
    "dompurify": "^3.4.17",
    "driver.js": "^1.4.0",
    "file-saver": "^2.0.5",
    "marked": "^17.0.1",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.2.5",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@intlify/message-compiler": "11.4.16",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/content-mapper": "4.0.0-alpha.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "7.1.0-beta",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "js-cookie": "3.0.7",
      "form-data@<4.0.6": ">=4.0.6",
      "postcss@<8.5.18": ">=8.5.18",
      "dompurify@<3.4.17": ">=3.4.17",
      "decode-uri-component@<0.5.1": ">=0.5.1",
      "source-map-js@<1.2.2": "1.2.2",
      "follow-redirects@<1.16.2": ">=1.16.2"
    }
  }
}
